{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:daily-ai-brief:run-state:v1",
  "title": "Daily AI Brief run state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_version",
    "revision",
    "run_id",
    "date",
    "timezone",
    "started_at",
    "finished_at",
    "status",
    "current_node",
    "budgets",
    "history",
    "candidates",
    "selection",
    "artifact",
    "publication",
    "persistence",
    "node_status",
    "trace",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-ai-brief.run/v1"
    },
    "graph_version": {
      "const": "daily-ai-brief.graph/v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "running",
        "blocked",
        "publish_failed",
        "failed",
        "succeeded"
      ]
    },
    "current_node": {
      "type": "string",
      "minLength": 1
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_seconds",
        "discovery_passes",
        "targeted_rounds",
        "targeted_searches",
        "artifact_repairs",
        "publish_retries",
        "live_checks"
      ],
      "properties": {
        "research_seconds": {
          "$ref": "#/$defs/budget"
        },
        "discovery_passes": {
          "$ref": "#/$defs/budget"
        },
        "targeted_rounds": {
          "$ref": "#/$defs/budget"
        },
        "targeted_searches": {
          "$ref": "#/$defs/budget"
        },
        "artifact_repairs": {
          "$ref": "#/$defs/budget"
        },
        "publish_retries": {
          "$ref": "#/$defs/budget"
        },
        "live_checks": {
          "$ref": "#/$defs/budget"
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runs_read",
        "people",
        "themes",
        "urls"
      ],
      "properties": {
        "runs_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "people": {
          "$ref": "#/$defs/unique_strings"
        },
        "themes": {
          "$ref": "#/$defs/unique_strings"
        },
        "urls": {
          "$ref": "#/$defs/unique_strings"
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_ids",
        "item_count",
        "shortfall_reason"
      ],
      "properties": {
        "candidate_ids": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "item_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "shortfall_reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "item_count": {
                "minimum": 1,
                "maximum": 9
              }
            },
            "required": [
              "item_count"
            ]
          },
          "then": {
            "properties": {
              "shortfall_reason": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "item_count": {
                "const": 10
              }
            },
            "required": [
              "item_count"
            ]
          },
          "then": {
            "properties": {
              "shortfall_reason": {
                "maxLength": 0
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "persistence": {
      "$ref": "#/$defs/persistence"
    },
    "node_status": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/node_status"
      }
    },
    "trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/trace_event"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication": {
            "properties": {
              "mode": {
                "const": "full_deployment"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "publication"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "blocked"
          },
          "current_node": {
            "const": "blocked"
          },
          "publication": {
            "properties": {
              "authorization_status": {
                "const": "required"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication": {
            "properties": {
              "mode": {
                "const": "content_refresh"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "publication"
        ]
      },
      "then": {
        "properties": {
          "publication": {
            "properties": {
              "authorization_status": {
                "const": "not_required"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "finished_at": {
            "type": "null"
          },
          "persistence": {
            "properties": {
              "run_log_status": {
                "enum": [
                  "not_written",
                  "pending_append"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "persistence": {
            "properties": {
              "run_log_status": {
                "const": "pending_append"
              }
            },
            "required": [
              "run_log_status"
            ]
          }
        },
        "required": [
          "persistence"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "running"
          },
          "current_node": {
            "const": "persist_success"
          },
          "persistence": {
            "properties": {
              "run_log_entry_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "current_node": {
            "const": "done"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "selection": {
            "properties": {
              "item_count": {
                "minimum": 1
              }
            }
          },
          "artifact": {
            "allOf": [
              {
                "$ref": "#/$defs/artifact"
              },
              {
                "properties": {
                  "validated": {
                    "const": true
                  },
                  "validated_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            ]
          },
          "publication": {
            "properties": {
              "mode": {
                "const": "content_refresh"
              },
              "authorization_status": {
                "const": "not_required"
              },
              "target_verified": {
                "const": true
              },
              "target_id": {
                "type": "string",
                "minLength": 1
              },
              "target_url": {
                "type": "string",
                "format": "uri"
              },
              "idempotency_key": {
                "type": "string",
                "minLength": 1
              },
              "delivery_status": {
                "enum": [
                  "updated",
                  "unchanged"
                ]
              },
              "live_status": {
                "const": "verified"
              },
              "attempts": {
                "type": "integer",
                "minimum": 1
              },
              "live_checks": {
                "type": "integer",
                "minimum": 1
              },
              "receipt_fingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "live_fingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "live_date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "live_item_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "archive_url": {
                "type": "string",
                "format": "uri"
              },
              "archive_status": {
                "const": "verified"
              },
              "archive_fingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "archive_date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "archive_item_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "failure_reason": {
                "maxLength": 0
              }
            }
          },
          "persistence": {
            "properties": {
              "run_log_status": {
                "const": "written"
              },
              "run_log_entry_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "current_node": {
            "const": "blocked"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "selection": {
            "properties": {
              "item_count": {
                "minimum": 1
              }
            }
          },
          "artifact": {
            "allOf": [
              {
                "$ref": "#/$defs/artifact"
              },
              {
                "properties": {
                  "validated": {
                    "const": true
                  },
                  "validated_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            ]
          },
          "publication": {
            "properties": {
              "delivery_status": {
                "const": "not_attempted"
              },
              "live_status": {
                "const": "not_checked"
              },
              "attempts": {
                "const": 0
              },
              "live_checks": {
                "const": 0
              }
            },
            "anyOf": [
              {
                "properties": {
                  "mode": {
                    "const": "full_deployment"
                  }
                }
              },
              {
                "properties": {
                  "target_verified": {
                    "const": false
                  }
                }
              }
            ]
          },
          "persistence": {
            "properties": {
              "run_log_status": {
                "const": "not_written"
              },
              "run_log_entry_sha256": {
                "type": "null"
              }
            }
          },
          "errors": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "publish_failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "current_node": {
            "const": "publish_failed"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "selection": {
            "properties": {
              "item_count": {
                "minimum": 1
              }
            }
          },
          "artifact": {
            "allOf": [
              {
                "$ref": "#/$defs/artifact"
              },
              {
                "properties": {
                  "validated": {
                    "const": true
                  },
                  "validated_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            ]
          },
          "publication": {
            "properties": {
              "target_verified": {
                "const": true
              }
            },
            "anyOf": [
              {
                "properties": {
                  "delivery_status": {
                    "enum": [
                      "failed",
                      "conflict"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "live_status": {
                    "enum": [
                      "failed",
                      "mismatch"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "archive_status": {
                    "enum": [
                      "failed",
                      "mismatch"
                    ]
                  }
                }
              }
            ]
          },
          "persistence": {
            "properties": {
              "run_log_status": {
                "const": "not_written"
              },
              "run_log_entry_sha256": {
                "type": "null"
              }
            }
          },
          "errors": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "current_node": {
            "const": "failed"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "artifact": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/artifact"
                  },
                  {
                    "properties": {
                      "validated": {
                        "const": true
                      },
                      "validated_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "persistence": {
            "properties": {
              "run_log_status": {
                "const": "not_written"
              },
              "run_log_entry_sha256": {
                "type": "null"
              }
            }
          },
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used",
        "max"
      ],
      "properties": {
        "used": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "unique_strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "original_url",
        "canonical_url",
        "tier",
        "kind",
        "published_date",
        "checked_at",
        "verified"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "original_url": {
          "type": "string",
          "format": "uri"
        },
        "canonical_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "kind": {
          "enum": [
            "primary",
            "independent",
            "specialist",
            "fallback"
          ]
        },
        "published_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impact",
        "source_quality",
        "freshness",
        "influence",
        "novelty",
        "total"
      ],
      "properties": {
        "impact": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "source_quality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "freshness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "influence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "novelty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "person",
        "role_org",
        "why_it_matters",
        "summary",
        "theme",
        "story_fingerprint",
        "history_overlap_reason",
        "selected_source_url",
        "sources",
        "scores",
        "confirmation_attempts",
        "status",
        "rejection_reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "person": {
          "type": "string",
          "minLength": 1
        },
        "role_org": {
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "story_fingerprint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "history_overlap_reason": {
          "enum": [
            "",
            "MATERIAL_NEW_DEVELOPMENT"
          ]
        },
        "selected_source_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "scores": {
          "anyOf": [
            {
              "$ref": "#/$defs/scores"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmation_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "discovered",
            "verified",
            "selected",
            "rejected"
          ]
        },
        "rejection_reason": {
          "type": "string",
          "pattern": "^(?:|[A-Z][A-Z0-9_]{1,63})$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "selected"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "story_fingerprint": {
                "type": "string",
                "minLength": 1
              },
              "selected_source_url": {
                "type": "string",
                "format": "uri"
              },
              "scores": {
                "$ref": "#/$defs/scores"
              },
              "rejection_reason": {
                "maxLength": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "rejection_reason": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "content_fingerprint",
        "item_count",
        "validated",
        "validated_at"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 over the ordered public fields person, role_org, why_it_matters, summary, selected source label, and canonical source URL."
        },
        "item_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "validated": {
          "type": "boolean"
        },
        "validated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "mode",
        "authorization_status",
        "target_verified",
        "target_id",
        "target_url",
        "idempotency_key",
        "delivery_status",
        "live_status",
        "attempts",
        "live_checks",
        "receipt_fingerprint",
        "live_fingerprint",
        "live_date",
        "live_item_count",
        "archive_url",
        "archive_status",
        "archive_fingerprint",
        "archive_date",
        "archive_item_count",
        "failure_reason"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "mode": {
          "enum": [
            "content_refresh",
            "full_deployment"
          ]
        },
        "authorization_status": {
          "enum": [
            "not_required",
            "required"
          ]
